APP_ENV=local
APP_DEBUG=1
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:///./jewellery.db
RUN_MIGRATIONS_ON_STARTUP=1
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=1
MAX_REQUEST_BODY_BYTES=1048576
HTTPS_REDIRECT=0
TRUSTED_HOSTS=*
PROXY_HEADERS=1
FORWARDED_ALLOW_IPS=*
HOST=0.0.0.0
PORT=7860
WEB_CONCURRENCY=1
UVICORN_LOG_LEVEL=info
RUN_MIGRATIONS_BEFORE_START=0

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15
RESEND_VERIFICATION_COOLDOWN_SECONDS=60

FRONTEND_VERIFY_URL=http://localhost:3000/verify-email
FRONTEND_RESET_URL=http://localhost:3000/reset-password
# Firebase app-login bridge for Android. Project ID is not a secret.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_ENABLED=0
FIREBASE_REQUIRE_EMAIL_VERIFIED=0

SMS_OTP_ENABLED=0
SMS_PROVIDER=onhand
SMS_TIMEOUT_SECONDS=10
SMS_HTTP_USER_AGENT=SonaJewelleryChatbot/1.0
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
PHONE_AUTH_PEPPER=
ONHANDSMS_API_URL=
ONHANDSMS_API_KEY=
ONHANDSMS_USERNAME=
ONHANDSMS_PASSWORD=
ONHANDSMS_SENDER_ID=
ONHANDSMS_ROUTE=transactional
ONHANDSMS_TEMPLATE_ID=
ONHANDSMS_METHOD=POST
ONHANDSMS_PAYLOAD_FORMAT=json
ONHANDSMS_PAYLOAD_TEMPLATE=
ONHANDSMS_MESSAGE_TEMPLATE=Your Sona Jewellery login OTP is {otp}. It expires in {minutes} minutes.

EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Jewellery Chat
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT_SECONDS=10
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

OMS_ENABLED=0
OMS_BASE_URL=
OMS_API_KEY=
OMS_TIMEOUT_SECONDS=10

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Simple OpenAI shortcut. Keep the real key in Hugging Face/local secrets, never in GitHub or Android.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra

# Generic OpenAI-compatible provider settings. These override OPENAI_* when present.
LLM_ENABLED=0
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=350

MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_TIMEOUT_SECONDS=5
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=0
ALERT_ERROR_THRESHOLD=5

ADMIN_BOOTSTRAP_ENABLED=0
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
