# LOCAL REVIEW TEMPLATE ONLY. This file is not loaded automatically.
# Existing billing sales/document flags remain disabled in all committed examples.
BILLING_B2C_CONTROLS_ENABLED=0
BILLING_CREDIT_SERIES_START_CONFIRMED=0
BILLING_CREDIT_SERIES_CONFIRMED_FY=
# Production always enforces B2C approval checks, regardless of the above switch.
# Set 1 only after future IRN integration is implemented and reviewed.
# Setting 1 now blocks issuance; it never invents an IRN.
BILLING_IRN_REQUIRED=0
BILLING_VERIFICATION_ENABLED=0
# Generate/store a dedicated random secret of at least 32 bytes outside source control.
BILLING_VERIFICATION_KEY=
# HTTPS API base, including any /sona prefix; no credentials, query or fragment.
BILLING_VERIFICATION_BASE_URL=
# Explicit written approvals are stored through the secured administrative API.
# No environment variable automatically approves tax classifications or rounding.
